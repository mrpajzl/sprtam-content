  "explanations": [
    {
      "title": "Tabulka",
      "blocks": [
        {
          "type": "heading",
          "text": "O čem to je"
        },
        {
          "type": "text",
          "text": "Abys mohl říct „jsem Tomáš“, „jsme z Česka“ nebo „Ana je milá“, potřebuješ sloveso **být**. Španělsky se jmenuje **ser** a je to jedno z nejdůležitějších slov vůbec."
        },
        {
          "type": "text",
          "text": "Dobrá zpráva: ser se mění podobně jako české „jsem, jsi, je“. Stačí se naučit šest tvarů."
        },
        {
          "type": "heading",
          "text": "Nové pojmy"
        },
        {
          "type": "term",
          "term": "Sloveso",
          "definition": "Slovo, které říká, co kdo dělá nebo jaký je.",
          "example": "být = *ser*, mluvit = *hablar*"
        },
        {
          "type": "term",
          "term": "Osobní zájmeno",
          "definition": "Krátké slovo místo jména osoby: já, ty, on, ona, my, vy, oni.",
          "example": "*yo* = já, *ella* = ona"
        },
        {
          "type": "term",
          "term": "Časování",
          "definition": "Měnění slovesa podle osoby. Česky: jsem, jsi, je, jsme, jste, jsou.",
          "example": "*yo soy* = já jsem, *tú eres* = ty jsi"
        },
        {
          "type": "heading",
          "text": "Osobní zájmena"
        },
        {
          "type": "table",
          "head": [
