        },
        {
          "type": "term",
          "term": "Záporný rozkaz",
          "definition": "Výzva, aby někdo něco **nedělal**. Vždy *no* + tvar subjuntiva.",
          "example": "¡No toques la sartén! – Nesahej na pánev!"
        },
        {
          "type": "term",
          "term": "Tykání a vykání",
          "definition": "*tú / vosotros* = tykání jednomu / více lidem. *usted / ustedes* = vykání jednomu / více lidem.",
          "example": "¡Pasa! (tú) – ¡Pase! (usted)"
        },
